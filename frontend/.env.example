# URL de la API. Déjela vacía en desarrollo (usa el proxy de Vite hacia el backend) o apunte al dominio en producción.
VITE_API_URL=/api/v1
# Destino del proxy de desarrollo
VITE_BACKEND_URL=http://127.0.0.1:8000
# Proveedor de teselas del mapa: revise sus términos de uso antes de producción (F-69).
VITE_TILE_URL=https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=Map data: &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors, SRTM | Map style: &copy; <a href="https://opentopomap.org">OpenTopoMap</a> (CC-BY-SA)
