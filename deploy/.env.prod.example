# =============================================================================
# Variables de producción (AWS / VPS). Copie a deploy/.env.prod y complete.
# En AWS este archivo lo genera el arranque de la instancia con claves aleatorias (infra/aws/wexperiencias.yml).
# .env.prod NUNCA se sube al repositorio (está en .gitignore).
# =============================================================================

# Dominio público (sin https://). Su registro DNS tipo A debe apuntar a la IP elástica.
DOMAIN=wexperiencias.example.cl
# Correo para avisos de Let's Encrypt (vencimiento de certificados)
LETSENCRYPT_EMAIL=admin@example.cl

# Claves: genere valores largos y aleatorios.
#   SECRET_KEY:        python -c "import secrets; print(secrets.token_urlsafe(64))"
#   POSTGRES_PASSWORD: openssl rand -base64 32 | tr -d '/+=' 
SECRET_KEY=cambie-esto-por-una-clave-larga-y-aleatoria-de-64-caracteres-o-mas
POSTGRES_DB=wexperiencias
POSTGRES_USER=wexp
POSTGRES_PASSWORD=cambie-esta-clave-de-base-de-datos

# Respaldos en S3 (bucket creado por infra/aws/wexperiencias.yml). Vacío = solo respaldos locales.
BACKUP_S3_BUCKET=
AWS_DEFAULT_REGION=us-east-1
# Días que se conservan los respaldos locales en /var/backups/wexperiencias
BACKUP_KEEP_DAYS=7

# Mapa: proveedor de teselas (ver docs/DECISION-TESELAS.md). Ejemplo MapTiler:
# VITE_TILE_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=SU_CLAVE_RESTRINGIDA_POR_DOMINIO
# VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.maptiler.com/copyright/">MapTiler</a> &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
VITE_TILE_URL=
VITE_TILE_ATTRIBUTION=

# Datos de ejemplo y documentación: DESACTIVADOS en producción real.
SEED_DEMO=false
ENABLE_API_DOCS=false

# Correo saliente (obligatorio para que lleguen confirmaciones de reserva)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=W Experiencias <no-reply@example.cl>

# Reglas de negocio
PLATFORM_FEE_PERCENT=10
BOOKING_PENDING_HOURS=48
PAYMENT_GATEWAY=bank_transfer
REVIEW_REQUIRE_CHECKOUT_PASSED=true
WEB_CONCURRENCY=3
