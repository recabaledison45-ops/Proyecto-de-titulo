# Copie a .env y exporte las variables (o use su gestor de secretos).
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=cambie-esta-clave-larga-y-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=
FRONTEND_URL=http://localhost:5173

# Base de datos: sqlite (defecto) o postgres
DB_ENGINE=sqlite
DB_NAME=wexperiencias
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Reglas de negocio
PLATFORM_FEE_PERCENT=10
BOOKING_PENDING_HOURS=48
PAYMENT_GATEWAY=bank_transfer      # bank_transfer | simulated
SIMULATED_GATEWAY_DECLINE=false
REVIEW_REQUIRE_CHECKOUT_PASSED=false   # true en producción

# Correo (producción)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=W Experiencias <no-reply@example.com>

MEDIA_ROOT=
LOG_LEVEL=INFO
