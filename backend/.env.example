# =============================================================================
# W Experiencias · variables de entorno del backend
# Copie este archivo a `.env` (cp .env.example .env) y ajuste los valores.
# `.env` está en .gitignore: NUNCA lo suba al repositorio.
# Las variables reales del sistema/plataforma tienen prioridad sobre este archivo.
# =============================================================================

# --- Entorno ---------------------------------------------------------------
# config.settings.local       -> desarrollo (DEBUG activo)
# config.settings.production  -> producción (HTTPS, HSTS, CORS estricto)
# Para `manage.py` el valor por defecto es local; para gunicorn/Docker, production.
DJANGO_SETTINGS_MODULE=config.settings.local

# Clave secreta. En producción es OBLIGATORIA y debe ser larga y aleatoria:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=cambie-esta-clave-larga-y-aleatoria

# Solo se respeta en local; en production siempre es False.
DEBUG=true

# Hosts permitidos (separados por coma). Obligatorio en producción.
# Ej.: api.midominio.cl,midominio.cl
ALLOWED_HOSTS=localhost,127.0.0.1

# --- CORS / CSRF -------------------------------------------------------------
# Orígenes del frontend autorizados a llamar a la API (con esquema, sin "/" final).
# En producción NO use comodines: liste solo su dominio real.
# Ej.: https://midominio.cl,https://www.midominio.cl
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Orígenes de confianza para CSRF (admin de Django sobre HTTPS). Ej.: https://api.midominio.cl
CSRF_TRUSTED_ORIGINS=
# URL pública del frontend (se usa en los correos).
FRONTEND_URL=http://localhost:5173

# --- Base de datos -----------------------------------------------------------
# Opción recomendada: una sola URL (Railway, Render, Heroku y Docker la entregan).
#   SQLite (desarrollo):  sqlite:///db.sqlite3
#   PostgreSQL (prod):    postgres://usuario:clave@host:5432/nombre
# Si se deja vacía, se usa SQLite (o las variables DB_* de más abajo).
DATABASE_URL=sqlite:///db.sqlite3

# Alternativa heredada (solo si DATABASE_URL está vacía):
DB_ENGINE=sqlite          # sqlite | postgres
DB_NAME=wexperiencias
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Docker Compose (PostgreSQL) --------------------------------------------
# Las lee docker-compose.yml para crear la base y construir DATABASE_URL.
POSTGRES_DB=wexperiencias
POSTGRES_USER=wexp
POSTGRES_PASSWORD=cambie-esta-clave-de-base-de-datos

# --- Servidor HTTP (producción) ----------------------------------------------
# Redirige HTTP->HTTPS. Poner false SOLO si prueba producción en local sin proxy TLS.
SECURE_SSL_REDIRECT=true
# Sirve /media/ desde Django (útil en Railway/Render con un disco/volumen).
# En un VPS con Nginx déjelo en false y sirva /media/ desde Nginx.
SERVE_MEDIA=false
# Ruta donde se guardan las imágenes subidas (opcional).
MEDIA_ROOT=
# Documentación Swagger (/api/docs/). En local siempre visible; en producción solo si pone true.
ENABLE_API_DOCS=false
# Procesos de gunicorn y puerto de escucha (el PORT lo inyectan Railway/Render).
WEB_CONCURRENCY=3
PORT=8000
GUNICORN_TIMEOUT=60

# --- Arranque del contenedor (entrypoint.sh) ---------------------------------
RUN_MIGRATIONS=true
RUN_COLLECTSTATIC=true
# true = carga usuarios y ofertas de ejemplo al arrancar (útil para una demo; clave demo1234).
SEED_DEMO=false
# Opcional: crea un superusuario la primera vez (si los tres están definidos).
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# --- Reglas de negocio --------------------------------------------------------
PLATFORM_FEE_PERCENT=10
BOOKING_PENDING_HOURS=48
PAYMENT_GATEWAY=bank_transfer          # bank_transfer | simulated
SIMULATED_GATEWAY_DECLINE=false
REVIEW_REQUIRE_CHECKOUT_PASSED=false   # true en producción

# --- Correo --------------------------------------------------------------------
# En desarrollo los correos se imprimen en consola.
# En producción use django.core.mail.backends.smtp.EmailBackend y complete EMAIL_*.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=W Experiencias <no-reply@example.com>

# --- Logs ----------------------------------------------------------------------
LOG_LEVEL=INFO
